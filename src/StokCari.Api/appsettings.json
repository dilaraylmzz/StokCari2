{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=stokcari;Username=postgres;Password=CHANGE_ME",
    "Redis": "localhost:6379,abortConnect=false,connectTimeout=2000,syncTimeout=1000,asyncTimeout=1000"
  },
  "Jwt": {
    "Issuer": "StokCari.Api",
    "Audience": "StokCari.Client",
    "Key": "",
    "ExpiryMinutes": 60
  },
  "AutoMapper": {
    "LicenseKey": ""
  },
  "Database": {
    "AutoMigrate": false
  },
  "Swagger": {
    "Enabled": false
  },
  "Seed": {
    "AdminUsername": "admin",
    "AdminEmail": "admin@example.com",
    "AdminPassword": "",
    "DemoData": false
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact" }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/stokcari-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  }
}
